/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "gpio-esp32.h"
#include "esp32s3.dtsi"

/ {
	memory@0 {
		device_type = "memory";
		reg = <0x3d800000 0x00800000>;
	};

	/*
	backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		default-on;
	};
	*/

	/* SAO port */
	i2c0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";

		sda-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	};

	/* Keyboard interface */
	i2c1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";

		sda-gpios = <&gpio0 47 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

		keypad: tca8418@34 {
			compatible = "ti,tca8418";
			reg = <0x34>;
			interrupt-parent = <&gpio0>;
			interrupts = <13 IRQ_TYPE_LEVEL_LOW>; /* Interrupt on GPIO pin IO13, falling edge */
			keypad,num-rows = <8>;
			keypad,num-columns = <10>;
			linux,keymap = <
				0x0001003b 0x0002004a 0x00030049 0x00040048 0x00050047 0x0006003c 0x0007003d 0x0008003e 0x0009003f
				0x01000001 0x01010010 0x01020011 0x01030012 0x01040013 0x01050014 0x01060015 0x01070016 0x01080017 0x01090018
				0x0200000f 0x0201001e 0x0202001f 0x02030020 0x02040021 0x02050022 0x02060023 0x02070024 0x02080025 0x02090026
				0x0300002a 0x0301002c 0x0302002d 0x0303002e 0x0304002f 0x03050030 0x03060031 0x03070032 0x03080033 0x03090034
				0x0400001d 0x0401007d 0x04020038 0x0403002b 0x04040039 0x0406006a 0x0407006c 0x04080069 0x04090064
				0x0502004a 0x0503004d 0x0504004c 0x0505004b 0x0506001b 0x0507001a 0x05080019
				0x06020037 0x06030051 0x06040050 0x0605004f 0x0606001c 0x06070028 0x06080027
				0x07020062 0x07030075 0x07040053 0x07050052 0x07060036 0x07070067 0x0708000e
			>;
		};
	};
};

&gpio_in_mux {
	status = "ok";
	usb_device_in: usb_device_in {
		pinctrl-single,pins = <
			GPIO_FUNC_IN_SEL(58) 0x38		/* usb_otg_iddig_in: fixed '1' */
			GPIO_FUNC_IN_SEL(59) 0x3c		/* usb_srp_avalid_in: fixed '0' */
			GPIO_FUNC_IN_SEL(60) 0x38		/* usb_srp_bvalid_in: fixed '1' */
			GPIO_FUNC_IN_SEL(61) 0x38>;		/* usb_otg_vbusvalid_in: fixed '1' */
	};

	usb_host_in: usb_host_in {
		pinctrl-single,pins = <
			GPIO_FUNC_IN_SEL(58) 0x3c		/* usb_otg_iddig_in: fixed '0' */
			GPIO_FUNC_IN_SEL(59) 0x38		/* usb_srp_avalid_in: fixed '1' */
			GPIO_FUNC_IN_SEL(60) 0x3c		/* usb_srp_bvalid_in: fixed '0' */
			GPIO_FUNC_IN_SEL(61) 0x38>;		/* usb_otg_vbusvalid_in: fixed '1' */
	};

	/* SX1262 LoRa Radio */
	spi2_gpio_in: spi2_gpio_in {
		pinctrl-single,pins = <
			GPIO_FUNC_OUT_SEL(9) 102>;		/* SPI2 MISO: GPIO9, signal 102 */
	};
};

&gpio_out_mux {
	status = "ok";

	/* All of the SPI peripherals are connected through the GPIO mux */
	/* SX1262 LoRa Radio */
	spi2_gpio_out: spi2_gpio_out {
		pinctrl-single,pins = <
			GPIO_FUNC_OUT_SEL(17) 110		/* SPI2 CS0:  GPIO17, signal 110 */
			GPIO_FUNC_OUT_SEL(3) 103		/* SPI2 MOSI: GPIO3, signal 103 */
			GPIO_FUNC_OUT_SEL(8) 101>;		/* SPI2 SCK:  GPIO8, signal 101 */
	};

	/* NV3007 LCD controller */
	spi3_gpio_out: spi3_gpio_out {
		pinctrl-single,pins = <
			GPIO_FUNC_OUT_SEL(41) 110		/* SPI3 CS0:  GPIO41, signal 71 */
			GPIO_FUNC_OUT_SEL(21) 103		/* SPI3 MOSI: GPIO21, signal 68 */
			GPIO_FUNC_OUT_SEL(38) 101>;		/* SPI3 SCK:  GPIO38, signal 66 */
	};
};

&rtc_iomux {
	status = "ok";
	usb_rtc_pins: usb_rtc_pins {
		pinctrl-single,pins = <
			PIN(19) RTC_MUX_SEL			/* USB_D- */
			PIN(20) RTC_MUX_SEL>;		/* USB_D+ */
	};
};

&iomux {
	status = "ok";

	/* None of the SPI peripherals are directly connected through IO MUX */
	/* SX1262 LoRa Radio */
	sx1262_pins: sx1262_pins {
		pinctrl-single,pins = <
			PIN(17) FUN0_DRV_20MA		/* CS0 */
			PIN(3) FUN0_DRV_20MA		/* MOSI */
			PIN(8) FUN0_DRV_20MA		/* SCK */
			PIN(9) FUN0_20MA_IE_WPU		/* MISO */
			PIN(10) FUN0_20MA			/* SW */
			PIN(15) FUN0_20MA_IE_WPU	/* BUSY */
			PIN(16) FUN0_20MA>;			/* DIO */
	};

	/* NV3007 LCD controller */
	lcd_pins: lcd_pins {
		pinctrl-single,pins = <
			PIN(41) FUN0_DRV_20MA		/* CS0 */
			PIN(21) FUN0_DRV_20MA		/* MOSI */
			PIN(38) FUN0_DRV_20MA		/* SCK */
			PIN(39) FUN0_DRV_20MA		/* D/C */
			PIN(40) FUN0_DRV_20MA>		/* RESET */
			PIN(2)  FUN0_20MA_IE_WPD    /* BACKLIGHT: FIXME */
			PIN(42) FUN0_20MA_IE_WPU>;	/* TE (FIXME -- pull-up for now) */
	};

	uart0_pins: uart0_pins {
		pinctrl-single,pins = <
			PIN(43) FUN0_20MA			/* U0TXD */
			PIN(44) FUN0_20MA_IE_WPU>;	/* U0RXD */
	};
	usb_pins: usb_pins {
		pinctrl-single,pins = <
			PIN(19) MUX_SLP_SEL			/* USB_D- */
			PIN(20) MUX_SLP_SEL>;		/* USB_D+ */
	};
};

&gpio0 {
	status = "ok";
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

/* NV3007 LCD Controller */
&spi3 {
	pinctrl-0 = <&spi3_pins &spi3_gpio_out>;
	pinctrl-names = "default";
	status = "ok";

	nv3007@0 {
		compatible = "nv3007-spi", "hackaday,nv3007";
		reg = <0>;
		spi-max-frequency = <80000000>;
		dc-gpios = <&gpio0 39 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 40 GPIO_ACTIVE_LOW>;
		rotation = <270>;
		/* backlight = <&backlight>; */
		status = "ok";

		pinctrl-0 = <&lcd_pins>;
		pinctrl-names = "default";
	};
};

/* SX1262 LoRa Radio */
&spi2 {
	pinctrl-0 = <&spi2_pins>;
	pinctrl-names = "default";
	status = "ok";

	/* FIXME: Replace with SX1262 radio
	mmc_spi@0 {
		compatible = "mmc-spi-slot";
		reg = <0>;
	};
	*/
};

&acm {
	status = "ok";
};

&usb_phy {
	status = "ok";
};

&usb {
#if 1
	dr_mode = "host";
	pinctrl-0 = <&usb_host_in &usb_rtc_pins>;
#else
	dr_mode = "peripheral";
	pinctrl-0 = <&usb_device_in &usb_rtc_pins>;
#endif
	pinctrl-names = "default";
	status = "ok";
};

&ipc {
	wifi@1 {
		compatible = "esp,esp32-wifi-shmem";
		reg = <1>;
	};
};

&intc {
	reg = <0x600c2800 0x800>;
};
